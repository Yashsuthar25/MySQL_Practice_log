DESCRIBE olist_order_items;
-- It has 4 columns for just different ID's, this could be a very important table for Joins.

-- Now, some basic checks.
SELECT 
 order_id,
 COUNT(order_id) AS Count_orders
FROM
 olist_database.olist_order_items
GROUP BY
 order_id
HAVING
 Count_orders <>1;
 /* I used this for Duplicates, but the results were unexpected, after with the help of AI and many reviews, I found out it needs 
 Some different query to find out the duplicates, going with that now, I thought including my mistakes is also important.*/

SELECT
 order_id, 
 order_item_id,
 COUNT(*) AS total_count
FROM 
 olist_database.olist_order_items
GROUP BY 
 order_id, order_item_id
HAVING
 total_count <>1;

-- Now, some counts, because as DESCRIBE query states, NULL's are allowed in all columns.
