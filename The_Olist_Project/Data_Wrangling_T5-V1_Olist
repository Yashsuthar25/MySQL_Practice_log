-- Let's check for the duplicates first.
SELECT 
 COUNT(review_id) AS count_distinct,
 review_id
FROM
 olist_database.olist_order_reviews
GROUP BY
 review_id
HAVING
 count_distinct >1;
-- Now, I've found 789 rows, which are repeated and mutliple sources from the internet confirm the same number.

