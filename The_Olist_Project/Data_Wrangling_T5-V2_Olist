SELECT
  r.review_id,
  r.order_id,
  o.customer_id
FROM
  olist_database.olist_order_reviews AS r
LEFT JOIN
  olist_database.olist_orders AS o
  ON r.order_id = o.order_id
WHERE
  r.review_id IN (
    SELECT
      review_id
    FROM 
     olist_database.olist_order_reviews
    GROUP BY 
     review_id
    HAVING 
     COUNT(*) > 1
  )
ORDER BY
  r.review_id;
