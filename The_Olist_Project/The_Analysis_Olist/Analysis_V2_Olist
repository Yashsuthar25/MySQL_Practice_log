-- **2: Now, I've to find out which are the top 10 states by volume of customers.
SELECT *
FROM
	olist_database.olist_customers
LIMIT 10;

SELECT 
	customer_id,
    customer_state,
    COUNT(*) AS Top_10_customer_state
FROM
	olist_database.olist_customers
GROUP BY
	customer_id
ORDER BY
	Top_10_customer_state DESC
LIMIT 
	10;
-- I know this query is a bit more lengthy than it should be, but I'm doing this based on my thinking.

-- **3, so now I've to find out what is the average review score and also how even is the average.
SELECT *
FROM
	olist_database.olist_order_reviews
LIMIT
	10;
    
SELECT
	AVG(review_score) AS 'avg_review_score'
FROM
	olist_database.olist_order_reviews;
-- Now, MySQL has a limitation, it doesn't have 'Mode' or 'Median' metrics, so it'll be an issue
-- to cross-verify the avg. 

-- now, for the distribution, I took the idea from AI.
SELECT
    review_score,
    COUNT(*) AS frequency,
    ROUND(COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (), 2) AS percentage
FROM 
	olist_database.olist_order_reviews
GROUP BY 
	review_score
ORDER BY 
	review_score;
/* the review_score avg is skewed because rating - 5 has the most counts but still avg is 
Around 4, which is not an accurate data skeweness check. */

