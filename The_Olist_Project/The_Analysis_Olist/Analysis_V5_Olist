-- Let's go with the first part of the task, which product cagtegories generates the most rev.
SELECT *
FROM
	olist_order_items
LIMIT 10;

WITH Revenue_table AS (SELECT
    i.price,
    i.product_id,
    p.product_category_name_english,
    i.order_id
FROM
	olist_database.olist_order_items AS i
LEFT JOIN
	olist_database.olist_products AS p
ON
	i.product_id = p.product_id)
SELECT
	SUM(price) AS Total_revenue,
    product_category_name_english
FROM
	Revenue_table
GROUP BY
	product_category_name_english
ORDER BY 
	Total_revenue DESC
LIMIT 10;
