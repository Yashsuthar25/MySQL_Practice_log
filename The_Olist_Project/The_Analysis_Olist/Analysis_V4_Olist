SELECT
	*
FROM
	olist_database.olist_orders
LIMIT
	10;
    
SELECT *
FROM
	olist_database.olist_customers
LIMIT
	10;
    
WITH date_difference_table AS (SELECT
    DATEDIFF(O_orders.order_delivered_carrier_date, O_orders.order_purchase_timestamp) AS Date_Difference,
    O_customers.customer_state
FROM
	olist_database.olist_orders AS O_orders
LEFT JOIN
	olist_database.olist_customers AS O_customers
ON 
	O_orders.customer_id = O_customers.customer_id)
SELECT
	AVG(Date_Difference) AS avg_date_difference,
    customer_state
FROM
	date_difference_table
GROUP BY
	customer_state;
